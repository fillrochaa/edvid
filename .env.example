OPENAI_API_KEY=
# PHASE 1 transcription of LONG sources (>5 min, e.g. YouTube videos / course lessons).
# Optional — with backend=auto, sources longer than 5 min use ElevenLabs Scribe when this
# key is set; short clips stay on OpenAI Whisper.
# Falls back to OpenAI if empty. https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# PHASE 2 illustrative images (Pexels) — https://www.pexels.com/api/
PEXELS_API_KEY=
# PHASE 3 AI soundtrack (Treblo) — only when the user picks AI-generated music
TREBLO_API_KEY=
# PHASE 2 brand/person images (Google Custom Search) — see skill for how to get these
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
