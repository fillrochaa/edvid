# Transcription needs NO key — WhisperX runs locally and ships with the skill.
#
# Everything below is OPTIONAL. The agent asks for each one lazily, the first
# time the feature is used, and writes it here.

# PHASE 2 illustrative images (Pexels) — https://www.pexels.com/api/
PEXELS_API_KEY=
# PHASE 3 AI soundtrack (Treblo) — only when the user picks AI-generated music
TREBLO_API_KEY=
# PHASE 2 brand/person images (Google Custom Search) — see skill for how to get these
# Wikimedia Commons is the no-key fallback and covers most cases.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
